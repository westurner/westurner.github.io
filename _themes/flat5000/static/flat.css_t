/* Typography */
@import url(https://fonts.googleapis.com/css?family=PT+Sans:400,700,400italic,700italic);
@import url(https://fonts.googleapis.com/css?family=Source+Code+Pro);

{%- set sans_serif_font = "'PT Sans', Helvetica, Arial, sans-serif" -%}
{%- set code_font = "'Source Code Pro', monospace, serif" -%} 

/* Palette */
{%- set background_color = "#d6d0c2" -%}
{%- set page_background_color = "#e3e0d3" -%}
{%- set page_background_shadow = "#c0c0b0" -%}
{%- set box_color = "#ece7d7" -%}
{%- set text_color = "#0c0501" -%}
{%- set theme_color_light = "#93a4ad" -%}
{%- set link_color = "#134aa7" -%}
{%- set link_visited_color = "#67052e" -%}
{%- set theme_accent_color = "rgb(102, 60, 80)" -%}
{%- set border_color = "#e0e0e0" -%}
{%- set aside_header_color = "#424242" -%}
{%- set article_background_color = "#ece7d7" -%}
{%- set article_background_color = "#dbd7ca" -%}

html { height: auto; }

body { font-family: {{ sans_serif_font }}; height: auto; }

header { text-align: center; }
header h1 * { font-size: 1.25em; }
header h2 { font-size: 1.4em; font-weight: normal; margin: 0; padding: 0; }

.h_underline { border-bottom: 3px solid #c0c0c0; padding-bottom: 4px; }
.h_underline a { text-decoration: none; }

nav { font-size: 1.5em; }

a { color: {{ link_color }} }

article { 
    background-color: {{ article_background_color }};
    box-shadow:
     -4px  -4px  12px {{ page_background_shadow }},
      4px  20px 120px {{ page_background_shadow }},
      8px 220px 120px {{ page_background_shadow }},
    -12px -12px  40px #faf0e0;
}

article p { line-height: 1.4; }

html[data-theme="dark"] a.headerlink,
article div.posts a.headerlink { border-bottom: 0; }
article div.posts a.headerlink:hover { display: none; border-bottom: 2px solid #222020; }

.highlight { font-size: .8em; }
/* .highlight { background: #ede9dd; } */
/* .highlight, .highlight .n, .highlight .ow, .highlight .o, .highlight .nn { color: black; }*/
.highlight pre { font-family: "Monaco", monospace; }


aside.sidebar h1,
aside.sidebar h1 a { font-size: 1.2em; color: {{ aside_header_color }}; }
aside.sidebar { padding: 20px 0; font-size: 1em; background: {{ background_color }}; }
html:not(.right-sidebar-collapsed) aside.sidebar { padding: 8px 0; }
aside.sidebar.highlight { font-size: .8em; }
aside.sidebar section h3 { margin-top: 0; padding-top: 0; }

ul#accounts { list-style-type: none; padding: 0; max-width: 670px; margin: 0 auto; text-align: center; }
ul#accounts li { display: inline-block; }
ul#accounts li img:hover { text-decoration: underline; border-bottom: 0; }

#accounts_ { margin: 0 10px; display: block !important; }

@media only screen and (min-width: 240px) {
    #accounts_ { max-width: 120px; margin: 0 auto; }
}

#searchbox input[type="text"], .searchbox input[type="text"] { width: 92%; border: 2px solid #a29f92; border-radius: 6px; background: #e8e4d8; padding: 6px; }

div.contents {  padding: 10px 0; }
div.contents p.topic-title { font-size: 1.5em; }
div.contents ul.simple { padding: 0 }
div.contents ul { list-style-type: none; margin: 0; }

table.footnote { opacity: 0.7; margin-top: 1em; }
table.footnote td { vertical-align: middle; padding-right: 1em; }
table.footnote td.label { vertical-align: top; word-break: initial; }

footer { font-size: 0.8em; opacity: 0.6; }
footer ul { list-style-type: none; }

code, kbd, pre, samp { font-family: {{ code_font }}; line-height: 1.4em; }

/*@media only screen and (min-width: 900px) {
    body { font-size: 1.1em; }
}*/

/* Layout */
ul { padding: 0 0 0 20px; list-style: circle; }

header { padding: 20px 0; }
header h1, span { margin: 0; }
header h1 { padding: 0 20px; }
header h2 { padding: 0 20px; display: block; }

nav.navbar { padding: 5px 0; }
nav.navbar { display: flex; justify-content: space-between; align-items: center; flex-direction: column; }
nav.navbar ul, nav ol { list-style: none; list-style-image: none; margin: 0; padding: 0; }
nav.navbar ul.main-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.3em;
    padding: 0;
    margin: 0;
}
nav.navbar ul.main-nav li {
    display: inline-block;
    padding: 0 10px;
    margin: 0;
    text-align: center;
    width: revert;
}
nav.navbar ul.main-nav li a {
  display: block;
  /* width: 100%; */
  border-bottom: 4px solid transparent;
  padding: 8px 0;
  transition: border-bottom 5s;
}
nav.navbar ul.main-nav li a:hover,
nav.navbar ul.main-nav li.active a { font-weight: 900; border-bottom: 4px solid {{ theme_accent_color }}; }

/* nav.navbar ul.main-nav li:has(> ul) */
nav.navbar ul.main-nav li:has(> ul li a) > ul li { padding: 0; }

ul.related { padding: 0; margin: 0 4px; list-style: none; }
ul.related li { line-height: 2em; list-style-type: none; text-align: center; }
article { padding: 20px 20px 10px 20px; overflow-x: hidden; }
article { word-wrap: break-word; word-break: break-word; }
article li { line-height: 1.5em; }
article h1 { margin-top: 0; }
ul.related:first-child { padding: 0 0 20px 0; }

div.highlight, { background-color: #333 !important; padding: 0.42em 0; }
div.highlight .c,
div.highlight .kn,
div.highlight .nn
div.highlight .n { background-color: inherit !important; }

div.highlight pre { overflow-x: auto; white-space: pre; word-wrap: normal; padding: 0px 10px;  }

/* div.postmeta { 
  height: 40px; 
  border-radius: 0 0 20px 20px;
  margin: 20px -40px;
  padding: 0 40px;
  box-shadow: 10px 20px 100px;
  opacity: 0.7;
  background: transparent; } */

aside.sidebar h1 { margin-top: 0; }
aside.sidebar div.widget { margin-bottom: 20px; padding: 0; }

div.archive_link { padding-top: 10px; text-align: center; }

/*blockquote { margin-left: -3em; margin-right:-3em; } */
blockquote:has(> div > div > div.highlight) {
    padding: 0;
    margin: 0;
    background: none;
    border: none;
}

div.footer-container { margin: 20px 0; }

@media only screen {
    body { background-color: {{ background_color }}; }
    footer { margin-bottom: 20px; padding: 20px; text-align: center; }
}

@media only print {
    body { background: none; }
    footer { margin-bottom: 20px; padding: 20px; text-align: left; }
    ul#accounts { display: none; }
}

@media only screen and (min-width: 480px) {
    header { margin: 20px 0; }
    header h1 { padding: 18px 0 0 0; }
    header h2 { padding: 2px; }

    nav { padding: 10px 0; }
    nav ul { margin: 0; padding: 0; text-align: center; }
    nav li { display: inline; list-style-type: none; text-align: left; width: auto; }
    nav li.main-nav { margin: 20px 0; padding: 0; }
    nav li.main-nav a { padding: 0 15px; }

    article { padding: 40px 40px 20px 40px; margin-bottom: 30px;  }
    /* background-color: #d6d0c2; */
    div.article { padding: 40px 0 40px 0; }
    /* ul.related { margin: 40px 0; padding: 20px 0 20px 0; } */
    ul.related li { display: inline; line-height: 1em; }
    ul.related li.right { display: inline; float: right; }
    ul.related:first-child { padding-bottom: 20px; }

    blockquote {
        margin-left: 0;
        margin-right:0;
    }

    div.highlight {
        margin-bottom: 10px;
        margin-left: -40px;
        margin-right: -40px;
    }

    /* div.section + div.postmeta { margin: 40px 0; } */

    aside.sidebar div.widget { margin-bottom: 30px; padding: 0 40px; }
    html:not(.right-sidebar-collapsed) aside.sidebar div.widget { padding: 0 12px; }

    div.archive_link { padding-top: 20px; text-align: center; }

    footer { padding: 10px 40px; }
}

/* 
div.main-container { background: {{ page_background_color }} } */

@media only screen and (min-width: 900px) {
  div.main-container:has(> div.main.wrapper.body.clearfix) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 26%;
    align-items: flex-start;
    gap: 24px;
  }
  div.main-container:has(> div.main.wrapper.body.clearfix) > div.main.wrapper.body.clearfix {
    grid-column: 1;
    width: 100%;
    min-width: 0;
    margin-inline: auto;
  }
  div.main-container:has(> div.main.wrapper.body.clearfix) > aside.sidebar {
    grid-column: 2;
    width: 100%;
    min-width: 0;
  }
  html.right-sidebar-collapsed div.main-container:has(> div.main.wrapper.body.clearfix) {
    grid-template-columns: minmax(0, 1fr);
  }
  html.right-sidebar-collapsed div.main-container:has(> div.main.wrapper.body.clearfix) > div.main.wrapper.body.clearfix,
  html.right-sidebar-collapsed div.main-container:has(> div.main.wrapper.body.clearfix) > aside.sidebar {
    grid-column: 1;
  }

    header { left: 0; top: 0; position: fixed; width: 26%; }

    /* nav { margin-left: 26%; } 
    nav ul { text-align: left; margin-left: 20px; } */
    /* nav { left: 0; top: 40%; position: fixed; width: 26%; } */
    nav li { text-align: center; width: 100%; }

    div.main-container { margin-left: 26%; }
    div.footer-container { margin-left: 26%; }

    div.highlight {
        padding: 10px 30px;
    }
}

@media only screen and (min-width: 1200px) {
    div.main-container { max-width: 60%; }
    div.footer-container { max-width: 60%; }
  div.main-container:has(> div.main.wrapper.body.clearfix) { max-width: none; }

    /* aside.sidebar { left: 74%; top: 0; position: absolute;  width: 26%; }  */
}

html.left-sidebar-collapsed header { display: none; }

@media only screen and (min-width: 900px) {
  html:not(.right-sidebar-collapsed) div.main-container:has(> div.main.wrapper.body.clearfix) > aside.sidebar {
    margin-top: 20em;
  }
    html.left-sidebar-collapsed div.main-container,
    html.left-sidebar-collapsed div.footer-container { margin-left: 0; }
}

@media only screen and (min-width: 1200px) {
    html.right-sidebar-collapsed div.main-container,
    html.right-sidebar-collapsed div.footer-container,
    html.left-sidebar-collapsed div.main-container,
    html.left-sidebar-collapsed div.footer-container { max-width: none; }
}

.sidebar-toggle-bar {
  position: fixed;
  top: 8px;
  left: 8px;
  z-index: 1000;
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  opacity: 0.5;
  transition: opacity 150ms ease;
}
.sidebar-toggle-bar:hover,
.sidebar-toggle-bar:focus-within { opacity: 0.9; }
.sidebar-toggle-bar button {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 6px 9px;
  border: 1px solid #a29f92;
  border-radius: 4px;
  background-color: #e8e4d8;
  color: #0c0501;
  font: inherit;
  font-size: 0.85em;
  cursor: pointer;
}
.sidebar-toggle-bar button:focus-visible { outline: 2px solid {{ theme_accent_color }}; outline-offset: 2px; }


header a, header a:visited, header a:hover, header a:active { color: {{ text_color }}; text-decoration: none; }
header h2 { color: {{ theme_color_light }}; }

a { color: {{ link_color }}; text-decoration: none; border-bottom: 3px solid transparent; }
a:visited { color: {{ link_visited_color }}; }
a:hover { color: {{ theme_accent_color }}; text-decoration: none; border-bottom: 3px solid {{ theme_accent_color }}; }
a.footnote-reference { vertical-align: super; }

h1 a, h2 a, h3 a, h4 a, h5 a, h6 a {
    border-bottom: 2px solid #ababab;
}

a.headerlink,
div.section h1 a.headerlink { color: #c8c0c2; margin-left: 4px; text-decoration: none; border-bottom: 0 }
/* a.headerlink:hover,
 div.section h1 a.headerlink:hover { color: {{ theme_accent_color }}
 * } */

div.section h1 a { color: {{ text_color }}; text-decoration: none; }
div.section h1 a.headerlink { color: #e0e0e0 }
div.section h1 a.headerlink:hover { color: #e0e0e0 }
.docutils.literal { background-color: {{ box_color }}; border: 1px solid {{ background_color }}; border-radius: 6px; padding: 0 4px; opacity: 0.9; }

blockquote { margin-left: 0; padding: 10px 20px; background: #ede9dd; border: 1px solid #d0d0d0;  }
blockquote, div.admonition, div.highlight { box-shadow: 0 0 5px rgba(0, 0, 0, 0.1); }
div.admonition { box-shadow: 0 0 5px rgba(0, 0, 0, 0.05); }

div.postmeta { color: {{ theme_color_light }}; }

/* Archive page */
span.title_tag, span.title_category { font-style: italic; }

div.year h1 { font-size: 1.6em; margin-bottom: 0; margin: 0 !important; }

div.year ul { display: inline-block; list-style-type: none; margin: 0; }

div.year div.postmeta { margin: 10px 0 10px 0; }

div.year div.timestamp { color: {{ text_color }}; font-size: 1.6em; font-weight: normal; margin-top: 1em; }

div.year h2 { margin-bottom: 20px; margin-top: 0; }

h1.posts_title { margin-top: -12px !important;  }

h1.posts_title { text-align: center !important; }

h1.posts_title, h1.posts_title a, h1.posts_title a:visited { color: #a0a0a0; text-decoration: none; }

nav.contents { margin-left: 0; font-size: 1em; text-align: left; }
nav.contents ul { margin-left: 1em; }
nav.contents li { margin-left: 0; font-size: 1em; text-align: left; }
section#table-of-contents {
  filter: brightness(0.9);
}

section h2 {
    padding-top: 1em;
}
section h3 {
    padding-top: 0.8em;
}

@media only screen and (min-width: 480px) {
    div.year h1 { float: left; margin-right: -100%; }

    /* div.year div.postmeta { margin: 0 0 40px 40%; } */
    div.year div.timestamp { float: none; clear: both; margin: 0; }
    div.year h2 { margin-left: 40%; }
}

/* inspired by Bootstrap CSS */
h1, h2, h3 { margin: 10px 0 10px 0 !important; }
p { margin: 0 0 10px; }
li p { margin: 0 0 4px; }
ul, ol { margin: 0 0 10px; }
div.line-block { margin: 0 0 10px; }
/* end inspired by Bootstrap CSS */

button, input, select, textarea {
    padding: 4px;
}

button.searchbutton { width: 2em; border: 2px solid #a29f92; border-radius: 4px; vertical-align: bottom; }

ul.search { list-style-type: none; margin: 0; padding: 0; }
ul.search li.search-result { background: #fff; color: #222; padding: 10px; margin: 10px 0; overflow-wrap: anywhere; }
.post-tags { display: flex; flex-wrap: wrap; gap: 4px 10px; margin-top: 6px; color: #5d5a50; font-size: 0.9em; }
.post-tags-label { font-weight: bold; }

div.sidebar { padding: 1em; margin: 1em; float:right; background: white; box-shadow: -2px -2px 10px #d0d0d0; }

span.highlighted, span.highlight { font-weight: bold; background: #fff2a8; color: #302b13; padding: 4px; margin: -4px; }

#twitter-widget-0 { width: 100% !important; height: 400px; }

#lifestream ul li {
    /* border-bottom: 1px solid #e0e0e0; */
    background-position: left 0.7em;
}

#lifestream ul.github-commits {
  margin-left: -7px;
}

#lifestream ul.github-commits li {
    padding: 0;
    /*font-family: mono;*/
    font-size: 0.9em;
    list-style-type: square;
    color: #aaa;
    padding-left: 6px;
}

#lifestream ul.github-commits li a {
    font-family: mono;
    color: grey;
    font-size: 0.9em;
}


#lifestream ul.github-commits li::marker {
    color: #c0c0c0;
}

#lifestream ul.github-commits li a {
    border-bottom: 0;
}

img.img-100 {
    width: 100%;
    margin-top: 2em;
}


/* mystnb.css modifications for dark background */
div.cell div.cell_input {
    border-left: 6px solid #733 !important;
    padding-left: 4px !important;
}
div.cell div.cell_output {
    border-left: 6px solid #b77 !important;
    padding-left: 4px !important;
}

div.cell div.cell_input,
div.cell div.cell_output,
.cell_output .output.text_plain, .cell_output .output.traceback, .cell_output .output.stream, .cell_output .output.stderr
{
    background-color: #333 !important;
}

.cell_output .output.text_plain, .cell_output .output.stream, .cell_output .output.stderr {
    border: 1px solid #333 !important;
}

.cell_output div.highlight { padding: 0; }


table.docutils td {
  border: 2px solid #c3bdad;
  padding: 0 8px;
}

/*
table.docutils td p {
  margin: 0 0 4px;
}*/

div.archive div.postmeta div.timestamp {
    font-size: 0.9em;
    color: #93a4ad;
}

article p {
  line-height: 1.3;
}

div.highlight-text {
  padding-top: 4px;
}

div.admonition {
  padding: 8px;
  background: #e8e4d8;
  margin-left: -16px;
  padding-left: 16px;
}

/* Scrollbars */

/* 1. Standard Properties (Firefox, modern Chrome/Edge/Safari) */
html {
  scrollbar-width: thin;               /* Options: auto | thin | none */
  scrollbar-color: #3e3d3d #111111;    /* thumb color | track color */
}

/* 2. WebKit Properties (Safari, old Chrome) */
/* Total width of the scrollbar */
html::-webkit-scrollbar {
  width: 12px;
  height: 12px;                        /* For horizontal scrollbars */
}

/* Background of the scrollbar path */
html::-webkit-scrollbar-track {
  background: #111111;
  border-radius: 6px;
}

/* Draggable handle */
html::-webkit-scrollbar-thumb {
  background: #3e3d3d;
  border-radius: 6px;
  border: 3px solid #22222;           /* Creates padding around thumb */
}

/* Draggable handle on hover */
html::-webkit-scrollbar-thumb:hover {
  background: #655555;
}



/* Settings */
.settings-container {
  position: fixed;
  top: 8px;
  right: 8px;
  left: auto;
  z-index: 1000;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  width: 240px;
  max-width: calc(100vw - 16px);
  box-sizing: border-box;
  --settings-panel-background: #f5f2e8;
  --settings-control-background: #e8e4d8;
  --settings-text: #0c0501;
  --settings-border: #a29f92;
  --settings-hover: rgba(0, 0, 0, 0.08);
}
html[data-theme="light"] .settings-container {
  --settings-panel-background: #f5f2e8;
  --settings-control-background: #e8e4d8;
  --settings-text: #0c0501;
  --settings-border: #a29f92;
  --settings-hover: rgba(0, 0, 0, 0.08);
}
html[data-theme="dark"] .settings-container {
  --settings-panel-background: #1b1917;
  --settings-control-background: #292522;
  --settings-text: #e3ddd3;
  --settings-border: #514a43;
  --settings-hover: #35302b;
}
.settings-container button,
.theme-selector-container select {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 6px 9px;
  border: 1px solid var(--settings-border);
  border-radius: 4px;
  background-color: var(--settings-control-background);
  color: var(--settings-text);
  font: inherit;
  font-size: 0.85em;
  cursor: pointer;
}
.settings-container button:focus-visible,
.theme-selector-container select:focus-visible { outline: 2px solid {{ theme_accent_color }}; outline-offset: 2px; }
.settings-toggle {
  font-weight: bold;
  opacity: 0.5;
  transition: opacity 150ms ease;
}
.settings-toggle:hover,
.settings-toggle:focus-visible,
.settings-container:focus-within .settings-toggle { opacity: 0.9; }
.settings-panel {
  width: 100%;
  min-width: 190px;
  box-sizing: border-box;
  margin-top: 6px;
  padding: 6px;
  border: 1px solid var(--settings-border);
  border-radius: 4px;
  background-color: var(--settings-panel-background);
  color: var(--settings-text);
  opacity: 1;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
}
.settings-panel[hidden] { display: none; }
.settings-panel[role="region"] { opacity: 1; }
.settings-list { list-style: none; margin: 0; padding: 0; }
.settings-list li { margin: 0; padding: 0; }
.settings-list > li + li { margin-top: 6px; }
.settings-container .settings-list button {
  display: flex;
  width: 100%;
  justify-content: flex-start;
  border: 0;
  background: transparent;
  text-align: left;
}
.settings-container .settings-list button:hover { background: var(--settings-hover); }
.display-setting-label {
  display: block;
  margin: 4px 8px;
  font-size: 0.85em;
  font-weight: bold;
}
.settings-options {
  display: flex;
  gap: 4px;
  padding: 0 4px;
}
.settings-container .settings-options button {
  flex: 1;
  justify-content: center;
  padding: 5px 4px;
  white-space: nowrap;
}
.settings-container .settings-options button[aria-pressed="true"] {
  border-color: {{ theme_accent_color }};
  box-shadow: inset 0 0 0 1px {{ theme_accent_color }};
}
.theme-selector-container {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 6px 9px;
}
.theme-selector-container select {
  padding: 2px 8px;
  display: block;
  border: 1px solid var(--settings-border);
  border-radius: 4px;
  box-shadow: none;
}

html[data-main-width="wide"] div.main-container[role="main"] > div.main.wrapper.body.clearfix { max-width: 100%; }
html[data-main-width="middle"] div.main-container[role="main"] > div.main.wrapper.body.clearfix { max-width: 80%; }
html[data-main-width="narrow"] div.main-container[role="main"] > div.main.wrapper.body.clearfix { max-width: 60%; }

html[data-main-font-size="small"] div.main-container[role="main"] > div.main.wrapper.body.clearfix { font-size: 0.9em; }
html[data-main-font-size="medium"] div.main-container[role="main"] > div.main.wrapper.body.clearfix { font-size: 1em; }
html[data-main-font-size="large"] div.main-container[role="main"] > div.main.wrapper.body.clearfix { font-size: 1.1em; }
html[data-main-font-size="x-large"] div.main-container[role="main"] > div.main.wrapper.body.clearfix { font-size: 1.2em; }

#search-results,
#tag-search-results {
  box-sizing: border-box;
  min-width: 0;
  width: 100%;
}

html[data-main-line-height="wide"] div.main-container[role="main"] article p,
html[data-main-line-height="wide"] div.main-container[role="main"] article li { line-height: 1.75; }
html[data-main-line-height="middle"] div.main-container[role="main"] article p,
html[data-main-line-height="middle"] div.main-container[role="main"] article li { line-height: 1.4; }
html[data-main-line-height="compact"] div.main-container[role="main"] article p,
html[data-main-line-height="compact"] div.main-container[role="main"] article li { line-height: 1.15; }
html[data-main-line-height="wide"] #search-results,
html[data-main-line-height="wide"] #tag-search-results { line-height: 1.75; }
html[data-main-line-height="middle"] #search-results,
html[data-main-line-height="middle"] #tag-search-results { line-height: 1.4; }
html[data-main-line-height="compact"] #search-results,
html[data-main-line-height="compact"] #tag-search-results { line-height: 1.15; }
/* Dark Mode */
@media (prefers-color-scheme: dark) {
  html:not([data-theme="light"]) body {
    background-color: #000;
  }
  html:not([data-theme="light"]) ul.search li.search-result {
    background: #191817;
    color: #b0aaaa;
    border: 1px solid #35332e;
  }
  html:not([data-theme="light"]) ul.search li.search-result a {
    color: #9bbaff;
  }
  html:not([data-theme="light"]) .post-tags {
    color: #b0aaaa;
  }
  html:not([data-theme="light"]) span.highlighted,
  html:not([data-theme="light"]) span.highlight {
    background: #f4c95d;
    color: #211b0b;
  }
  html:not([data-theme="light"]) article {
    background-color: #010101;
    box-shadow: 0 !important;
    border: 1px solid #181818;
  }
  html:not([data-theme="light"]) table.docutils td {
    border: 2px solid #302f2f;
  }
  html:not([data-theme="light"]) div.admonition {
    background: #272521;
  }
  html:not([data-theme="light"]) a {
    color: #336ccc;
  }
  html:not([data-theme="light"]) .docutils.literal {
    background-color: #2e2d27;
    border: 1px solid #3f3d38;
  }
  html:not([data-theme="light"]) a:visited {
    color: #4d3d44;
  }
  html:not([data-theme="light"]) h1 a,
  html:not([data-theme="light"]) h2 a,
  html:not([data-theme="light"]) h3 a,
  html:not([data-theme="light"]) h4 a,
  html:not([data-theme="light"]) h5 a,
  html:not([data-theme="light"]) h6 a {
    border-bottom: 2px solid #222020;
  }
  html:not([data-theme="light"]) a.headerlink,
  html:not([data-theme="light"]) div.section h1 a.headerlink {
    color: #262223;
  }
  //html:not([data-theme="light"]) header a:visited,
  //html:not([data-theme="light"]) header a:hover,
  //html:not([data-theme="light"]) header a:active 
  html:not([data-theme="light"]) header a,
  {
    color: #272625;
  }
  html:not([data-theme="light"]) header h2 {
    color: #2f3639;
  }
  html:not([data-theme="light"]) ul#accounts {
    padding: 12px;
    margin: 0 -12px;
    opacity: 0.5;
    background: #60606073;
  }
  html:not([data-theme="light"]) blockquote {
    background: #181817;
    border: 1px solid #151414;
  }
  html:not([data-theme="light"]) aside.sidebar {
    background: #11100f;
  }
  html:not([data-theme="light"]) #searchbox input[type="text"],
  html:not([data-theme="light"]) .searchbox input[type="text"] {
    border: 2px solid #35332e;
    background: #191817;
  }
  html:not([data-theme="light"]) button.searchbutton {
    border: 2px solid #36352e;
    background-color: #000;
  }
  html:not([data-theme="light"]),
  html:not([data-theme="light"]) button,
  html:not([data-theme="light"]) input,
  html:not([data-theme="light"]) select,
  html:not([data-theme="light"]) textarea {
    color: #999;
  }
  html:not([data-theme="light"]) .highlight {
    background: #0f0f0f;
  }
  html:not([data-theme="light"]) .theme-selector-container select {
    border: 1px solid #35332e;
    background-color: #191817;
    color: #999;
  }
}

html[data-theme="dark"] body {
  background-color: #000;
}
html[data-theme="dark"] article {
  /*background-color: #151414;*/
  box-shadow: none !important;
  border: 4px solid #181818;
}

html[data-theme="dark"] table.docutils td {
  border: 2px solid #191919;
}
html[data-theme="dark"] div.admonition {
  background: #272521;
}

html[data-theme="dark"] .docutils.literal {
  background-color: #151411;
  border: 1px solid #2a2825;
  opacity: 0.7;
}


html[data-theme="dark"] a {
  /* color: #336ccc; */
  color: #a46a84;
}
html[data-theme="dark"] a:visited {
  /* color: #4d3d44; */
  color: #8e6f7d;
}
html[data-theme="dark"] h1 a,
html[data-theme="dark"] h2 a,
html[data-theme="dark"] h3 a,
html[data-theme="dark"] h4 a,
html[data-theme="dark"] h5 a,
html[data-theme="dark"] h6 a {
  border-bottom: 2px solid #222020;
}

html[data-theme="dark"] h1 a:hover,
html[data-theme="dark"] h2 a:hover,
html[data-theme="dark"] h3 a:hover,
html[data-theme="dark"] h4 a:hover,
html[data-theme="dark"] h5 a:hover,
html[data-theme="dark"] h6 a:hover {
  color: #8b6666;
}


html[data-theme="dark"] a.headerlink,
html[data-theme="dark"] div.section h1 a.headerlink {
  color: #262223;
}

html[data-theme="dark"] a.headerlink:hover,
html[data-theme="dark"] div.section h1 a.headerlink:hover {
  color: #8b6666;
}

//html[data-theme="dark"] header a:visited,
//html[data-theme="dark"] header a:hover,
//html[data-theme="dark"] header a:active
html[data-theme="dark"] header a,
 {
  color: #272625;
}


html[data-theme="dark"] header h2 {
  color: #2f3639;
}
html[data-theme="dark"] ul#accounts {
  padding: 12px;
  margin: 0 -12px;
  opacity: 0.5;
  background: #60606073;
}

html[data-theme="dark"] div.main-container aside ul#accounts {
  display: block;
  margin: 0 auto;
}

html[data-theme="dark"] blockquote {
  background: #181817;
  border: 1px solid #151414;
}
html[data-theme="dark"] aside.sidebar {
  background: #11100f;
}
html[data-theme="dark"] #searchbox input[type="text"],
html[data-theme="dark"] .searchbox input[type="text"] {
  border: 2px solid #35332e;
  background: #191817;
}
html[data-theme="dark"] button.searchbutton {
  border: 2px solid #36352e;
  background-color: #000;
}
html[data-theme="dark"] ul.search li.search-result {
  color: #b0aaaa;
  /* border: 1px solid #35332e; */
  border: 2px solid #191817;
  background: none;
  border-radius: 10px;
}
html[data-theme="dark"] ul.search li.search-result a {
  color: #9bbaff;
}
html[data-theme="dark"] .post-tags {
  color: #b0aaaa;
}
html[data-theme="dark"] span.highlighted,
html[data-theme="dark"] span.highlight {
  background: #7c662d;
  color: #211b0b;
  opacity: 0.8;
}

@media (forced-colors: active) {
  span.highlighted,
  span.highlight {
    background-color: Highlight;
    color: HighlightText;
  }
}

html[data-theme="dark"],
html[data-theme="dark"] button,
html[data-theme="dark"] input,
html[data-theme="dark"] select,
html[data-theme="dark"] textarea {
  color: #b0aaaa;
}

html[data-theme="dark"] button,
html[data-theme="dark"] input,
html[data-theme="dark"] select,
html[data-theme="dark"] textarea {
  background-color: #362020;
  border-radius: 6px;
}
html[data-theme="dark"] .highlight {
  background-image: linear-gradient(50deg,#050500,#161010);
  color: #b0aaaa;
  opacity: 0.8;

  border-left: 16px solid #161010;
}


html[data-theme="dark"] .theme-selector-container select {
  border: 1px solid #35332e;
  background-color: #191817;
  color: #999;
}

html[data-theme="dark"] .settings-container button,
html[data-theme="dark"] .settings-container select {
  border-color: var(--settings-border);
  background-color: var(--settings-control-background);
  color: var(--settings-text);
}
html[data-theme="dark"] .theme-selector-container select {
  border: 1px solid var(--settings-border);
  border-radius: 4px;
}
html[data-theme="dark"] .settings-container .settings-list button {
  background: transparent;
}
html[data-theme="dark"] .settings-container .settings-list button:hover {
  background: var(--settings-hover);
}

html[data-theme="dark"] ::selection {
  background: #472e2c;
  text-shadow: none;
}


html[data-theme="dark"] input:focus-visible,
#searchbox input[type="text"]:focus-visible, .searchbox input[type="text"]:focus-visible
 {

  /* 1. Clear Firefox's default focus ring */
  outline: none;
  
  /* 2. Apply your custom border style */
  /*border: 2px solid #0066cc;*/
  border: 2px solid #472e2c;
  
  /* 3. Optional: Add a box-shadow for a glow effect */
  /*box-shadow: 0 0 4px rgba(0, 102, 204, 0.5);*/
  box-shadow: 0 0 8px rgb(117, 23, 23);

  /* text-shadow: none; */
}

html[data-theme="dark"] div.year div.timestamp { color: #e8e8d3;  }



div.post div.postmeta { 
    margin-top: 2em;
}

div.post .timestamp {
  font-weight: bold;
  font-size: 1.2em;
  font-style: italic;
}

html[data-theme="dark"] div.post div.postmeta {
    opacity: 0.8;
}

html[data-theme="dark"] article h1 {
    color: #8e6f7d;
}

.del, .strike {
  text-decoration: line-through;
}



table.docutils {
  border-collapse: collapse;
}

table.docutils tr td {
  padding: 0 4px;
}

table.docutils td p {
  margin: 2px 0;
}

tr.row-odd {
  background-color: #c3bdad; /* light mode */
}

html[data-theme="dark"] tr.row-odd {
  background-color: #191919; /* dark mode */
}

ul.related {
  padding: 8px 4px;
}